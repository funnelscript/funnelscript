world D2CSeasonalScaleStress {
  import "ecommerce/d2c_scale" as D2C;

  // 30-Day Seasonal Push doubling spend from $5,000/day to $10,000/day.
  // Profile: MENA/Emerging Market D2C Brand
  // - 65% Cash on Delivery (COD) share
  // - 18% COD Return-to-Origin (RTO) rate
