  // - 3-day online payment gateway settlement
  // - 35% COGS and round-trip shipping drag
  //
  // Failure Mode:
  // - Booked Paper ROAS remains strong (> 2.8x)
  // - Working capital collapses into insolvency mid-month (Day 17-21)
}
